# Anthropic API key for AI-powered categorization.
# Get one at https://console.anthropic.com
# If empty, the categorizer falls back to deterministic keyword rules.
ANTHROPIC_API_KEY=

# Model used for transaction categorization.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# SQLite path (relative to backend/). Use postgresql://user:pass@host/db for Postgres.
DATABASE_URL=sqlite:///./spendlens.db

# CORS — comma separated origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
